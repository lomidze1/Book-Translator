# Database
DATABASE_URL="postgresql://book_translator:book_translator_pass@localhost:5433/book_translator"
POSTGRES_USER=book_translator
POSTGRES_PASSWORD=book_translator_pass
POSTGRES_DB=book_translator

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_REFRESH_SECRET=your-refresh-secret-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS
CORS_ORIGIN=http://localhost:3000

# API
PORT=4000

# Initial admin promotion (see apps/api/.env.example for details)
INITIAL_ADMIN_EMAIL=

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3 (Phase 2)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Claude API (Phase 3)
# ANTHROPIC_API_KEY=
