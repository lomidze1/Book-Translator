generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Phase 1 Models ===

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  passwordHash  String?
  name          String?
  avatar        String?
  role          Role      @default(USER)
  locale        String    @default("ka")

  // Email verification
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  // Password reset
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?

  // Token versioning (increment to invalidate all sessions)
  tokenVersion  Int       @default(0)

  // Relations
  accounts        Account[]
  books           UserBook[]
  payments        Payment[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  notes           Note[]
  readingProgress ReadingProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passwordResetToken, passwordResetExpires])
  @@index([emailVerificationToken, emailVerificationExpires])
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// === Phase 2+ Models (stubs for relations) ===

model Book {
  id             String     @id @default(cuid())
  title          String
  author         String?
  description    String?
  isbn           String?    @unique
  coverUrl       String?
  language       String     @default("en")
  pageCount      Int?
  fileHash       String?    @unique
  originalFileUrl String?
  originalFormat FileFormat
  fileSize       Int?
  googleBooksId  String?
  openLibraryId  String?
  buyLinks       Json?

  translations    Translation[]
  userBooks       UserBook[]
  chapters        Chapter[]
  audioBooks      AudioBook[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  notes           Note[]
  readingProgress ReadingProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([googleBooksId])
  @@index([openLibraryId])
  @@index([title])
  @@index([author])
}

enum FileFormat {
  PDF
  EPUB
  TXT
  DOCX
}

model Chapter {
  id              String  @id @default(cuid())
  bookId          String
  book            Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number          Int
  title           String?
  originalContent String
  wordCount       Int?

  translatedChapters TranslatedChapter[]
  audioChapters      AudioChapter[]

  @@unique([bookId, number])
  @@index([bookId])
}

model Translation {
  id              String            @id @default(cuid())
  bookId          String
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sourceLanguage  String            @default("en")
  targetLanguage  String            @default("ka")
  status          TranslationStatus @default(PENDING)
  translationType TranslationType   @default(FAST)
  progress        Float             @default(0)
  estimatedPrice  Decimal?          @db.Decimal(10, 2)
  aiModel         String?
  totalTokensUsed Int?
  glossary        Json?

  translatedChapters TranslatedChapter[]
  audioBooks         AudioBook[]
  payment            Payment?

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([status])
  @@index([bookId, status])
}

enum TranslationType {
  FAST
  STANDARD
}

enum TranslationStatus {
  PENDING
  PAID
  IN_PROGRESS
  COMPLETED
  FAILED
}

model TranslatedChapter {
  id                String      @id @default(cuid())
  translationId     String
  translation       Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  chapterId         String
  chapter           Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  translatedContent String
  editedContent     String?
  isEdited          Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([translationId, chapterId])
  @@index([translationId])
  @@index([chapterId])
}

model UserBook {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type          UserBookType
  translationId String?

  addedAt DateTime @default(now())

  @@unique([userId, bookId, type])
  @@index([userId])
  @@index([bookId])
}

enum UserBookType {
  UPLOADED
  PURCHASED_ORIGINAL
  PURCHASED_TRANSLATION
}

model Payment {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationId   String?        @unique
  translation     Translation?   @relation(fields: [translationId], references: [id], onDelete: SetNull)
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("GEL")
  status          PaymentStatus  @default(PENDING)
  provider        PaymentProvider
  providerOrderId String?        @unique
  providerTxId    String?
  type            PaymentType
  description     String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([userId, status])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  BOG
  TBC
}

enum PaymentType {
  TRANSLATION
  PURCHASE_ORIGINAL
  PURCHASE_TRANSLATION
}

model Bookmark {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber Int
  position      Int
  label         String?

  createdAt DateTime @default(now())

  @@unique([userId, bookId, chapterNumber, position])
  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
}

model Highlight {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber Int
  startPosition Int
  endPosition   Int
  color         String @default("yellow")
  selectedText  String

  notes Note[]

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
}

model Note {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlightId   String?
  highlight     Highlight? @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber Int
  content       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bookId])
  @@index([highlightId])
  @@index([userId, bookId])
}

model ReadingProgress {
  id              String @id @default(cuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentChapter  Int    @default(1)
  currentPosition Int    @default(0)
  percentage      Float  @default(0)

  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model AudioBook {
  id              String      @id @default(cuid())
  bookId          String
  book            Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  translationId   String
  translation     Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  language        String      @default("ka")
  voiceId         String
  status          AudioStatus @default(PENDING)
  progress        Float       @default(0)
  totalDuration   Int?
  totalSize       Int?
  totalChapters   Int         @default(0)
  completedChapters Int       @default(0)

  chapters AudioChapter[]

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, translationId, voiceId])
  @@index([bookId])
  @@index([translationId])
  @@index([status])
}

enum AudioStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

model AudioChapter {
  id            String             @id @default(cuid())
  audioBookId   String
  audioBook     AudioBook          @relation(fields: [audioBookId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterNumber Int
  audioUrl      String?
  duration      Int?
  fileSize      Int?
  format        String             @default("mp3")
  status        AudioChapterStatus @default(PENDING)
  timestamps    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([audioBookId, chapterNumber])
  @@index([audioBookId])
  @@index([chapterId])
  @@index([status])
  @@index([audioBookId, chapterNumber, status])
  @@index([audioBookId, status])
}

enum AudioChapterStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}
