# Database
DATABASE_URL="postgresql://user:password@localhost:5433/book_translator"

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS
CORS_ORIGIN=http://localhost:3000

# API
PORT=4000
NODE_ENV=development

# Initial admin promotion. After registering this email at /register,
# run `pnpm --filter @book-translator/api db:seed` once to grant ADMIN role.
# Safe to re-run; the seed is idempotent.
INITIAL_ADMIN_EMAIL=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-bucket-name

# Claude API (Translation)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Translation model (default: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Gemini (translation quality judge — optional; judging is skipped when unset)
GEMINI_API_KEY=
# Judge model (default: gemini-2.5-pro)
GEMINI_JUDGE_MODEL=

# Resend (Email)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000

# Pricing (GEL per page)
PRICE_PER_PAGE_FAST=0.15
PRICE_PER_PAGE_SLOW=0.07
PRICE_MIN=10
PRICE_EXISTING=5
PRICE_CURRENCY=GEL
# Resale of already-uploaded originals ($1) and completed translations (5 GEL).
# Disabled by default until licensing agreements exist (docs/risk/07-action-plan.md A1).
ENABLE_BOOK_RESALE=false

# Audio (TTS) generation. Paused for launch — reading already-generated audio
# still works, only new synthesis is blocked.
ENABLE_TTS=false

# Free preview: translate the first ~4 pages so users can judge quality before
# paying. Each generation is one Claude call, so keep the quota tight at first.
ENABLE_PREVIEW=false
PREVIEW_DAILY_LIMIT=3
PREVIEW_MAX_CONCURRENT_JOBS=2

# API base URL (used to build the Flitt callback URL)
API_URL=http://localhost:4000

# Flitt payment provider (TBC Bank subsidiary)
# Docs: https://docs.flitt.com/getting-started/redirect
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# TTS Configuration
TTS_PRIMARY_PROVIDER=google-cloud
TTS_FALLBACK_PROVIDERS=elevenlabs,azure
TTS_MAX_CONCURRENT_JOBS=2
TTS_AUDIO_FORMAT=mp3
TTS_AUDIO_BITRATE=128k
TTS_AUDIO_SAMPLE_RATE=24000
TTS_CROSSFADE_MS=50
TTS_PRESIGNED_URL_EXPIRY=14400

# Google Cloud TTS
GOOGLE_CLOUD_TTS_CREDENTIALS_PATH=./credentials.json
GOOGLE_CLOUD_TTS_PROJECT_ID=your-project-id

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Azure TTS (optional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@booktranslator.ge

# Sentry (optional)
SENTRY_DSN=
