# Database
DATABASE_URL="postgresql://user:password@localhost:5433/book_translator"

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Google OAuth
# Only GOOGLE_CLIENT_ID is read by the API — sign-in verifies the ID token the
# browser already obtained, so no server-side code exchange happens. The secret
# is kept here because the Google Cloud console issues the pair together.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Books API key (optional). Book search falls back to unauthenticated
# requests when unset, which Google rate-limits far more aggressively.
GOOGLE_BOOKS_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:3000

# API
PORT=4000
NODE_ENV=development

# Initial admin promotion. After registering this email at /register,
# run `pnpm --filter @book-translator/api db:seed` once to grant ADMIN role.
# Safe to re-run; the seed is idempotent.
INITIAL_ADMIN_EMAIL=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty for a passwordless local Redis. Managed Redis (Railway) usually
# embeds the password in REDIS_URL, in which case this stays empty too.
REDIS_PASSWORD=

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-bucket-name

# Claude API (Translation)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Translation model (default: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5
# USD per million tokens, used only to price the admin dashboard's cost report.
# Defaults: blended 9, input 3, output 15. Update when Anthropic pricing changes.
CLAUDE_BLENDED_USD_PER_MTOK=
CLAUDE_INPUT_USD_PER_MTOK=
CLAUDE_OUTPUT_USD_PER_MTOK=

# Gemini (translation quality judge — optional; judging is skipped when unset)
GEMINI_API_KEY=
# Judge model (default: gemini-2.5-pro)
GEMINI_JUDGE_MODEL=

# Resend (Email)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000

# Pricing (GEL per page)
PRICE_PER_PAGE_FAST=0.15
PRICE_PER_PAGE_SLOW=0.07
PRICE_MIN=10
PRICE_EXISTING=5
PRICE_CURRENCY=GEL
# Resale of already-uploaded originals ($1) and completed translations (5 GEL).
# Disabled by default until licensing agreements exist (docs/risk/07-action-plan.md A1).
# WARNING: only enable with signed licensing agreements with publishers — selling
# translations of third-party uploads without a license risks BOG/TBC merchant
# account termination. The UI surface and the CreatePaymentDto PURCHASE_* types
# were also removed; re-enabling requires restoring those, not just this flag.
ENABLE_BOOK_RESALE=false

# Audio (TTS) generation. Paused for launch — reading already-generated audio
# still works, only new synthesis is blocked.
ENABLE_TTS=false

# Free preview: translate the first ~4 pages so users can judge quality before
# paying. Each generation is one Claude call, so keep the quota tight at first.
ENABLE_PREVIEW=false
PREVIEW_DAILY_LIMIT=3
PREVIEW_MAX_CONCURRENT_JOBS=2

# API base URL (used to build the Flitt callback URL)
API_URL=http://localhost:4000

# Flitt payment provider (TBC Bank subsidiary)
# Docs: https://docs.flitt.com/getting-started/redirect
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=

# TTS Configuration
TTS_PRIMARY_PROVIDER=google-cloud
TTS_FALLBACK_PROVIDERS=elevenlabs,azure
TTS_MAX_CONCURRENT_JOBS=2
TTS_AUDIO_FORMAT=mp3
TTS_AUDIO_BITRATE=128k
TTS_AUDIO_SAMPLE_RATE=24000
TTS_CROSSFADE_MS=50
TTS_PRESIGNED_URL_EXPIRY=14400
# How often the provider manager re-probes a failed TTS provider (default 300000 = 5 min).
TTS_HEALTH_CHECK_INTERVAL_MS=
# Max bytes per synthesis request. Each provider caps request size, so text is
# split into chunks below the limit. Defaults: ElevenLabs 4500, Google 5000.
TTS_CHUNK_MAX_BYTES=
TTS_CHUNK_MAX_BYTES_GOOGLE=

# Google Cloud TTS
GOOGLE_CLOUD_TTS_CREDENTIALS_PATH=./credentials.json
GOOGLE_CLOUD_TTS_PROJECT_ID=your-project-id
# Standard Google SDK fallback: path to a service-account JSON. Only needed when
# GOOGLE_CLOUD_TTS_CREDENTIALS_PATH and GOOGLE_CLOUD_TTS_PROJECT_ID are unset.
GOOGLE_APPLICATION_CREDENTIALS=

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Azure TTS (optional)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@booktranslator.ge

# Sentry (optional)
SENTRY_DSN=

# Local development shortcuts (skips email verification and similar gates).
# NEVER set this in production — it is an authentication bypass.
ENABLE_DEV_SHORTCUTS=false
