# Backend API. REQUIRED — a release build throws at startup without it
# (see src/config.ts). Must be https:// for iOS ATS.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Public web app. Used only for the legal pages linked from Settings.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# In-app purchasing. Keep false while checkout is Flitt's external web form —
# that violates Apple Guideline 3.1.1 and Google Play Billing policy.
# Flip only once StoreKit / Play Billing ship.
EXPO_PUBLIC_ENABLE_PURCHASES=false

# Audio (TTS). Paused for release 1; planned for release 2-3. Turning it on also
# requires restoring the native declarations in app.json (_comment_audio_paused).
EXPO_PUBLIC_ENABLE_TTS=false

# Google OAuth. Three separate clients from Google Cloud Console:
#   IOS     — bundle id ge.booktranslator.app
#   ANDROID — package ge.booktranslator.app + SHA-1 of the EAS keystore
#   (web)   — audience for the id_token the backend verifies
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
