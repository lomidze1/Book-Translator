# API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Site URL (for SEO, OG tags)
NEXT_PUBLIC_SITE_URL=https://booktranslator.ge

# Web Push (VAPID public key — safe to expose)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Google OAuth (for Sign in with Google button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Audio (TTS) UI. Paused for launch — must match the API's ENABLE_TTS.
NEXT_PUBLIC_ENABLE_TTS=false

# Free translation preview UI — must match the API's ENABLE_PREVIEW.
NEXT_PUBLIC_ENABLE_PREVIEW=false

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
